---
import Base from "@/layouts/Base.astro";
---

<Base title="페이지를 찾을 수 없습니다" noindex={true}>
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span
            class="text-[8rem] block font-bold text-text-dark dark:text-darkmode-text-dark"
          >
            404
          </span>
          <h1 class="h2 mb-4">페이지를 찾을 수 없습니다</h1>
          <div class="content">
            <p>요청하신 페이지가 삭제되었거나 주소가 변경되었을 수 있습니다.</p>
          </div>
          <a href="/" class="btn btn-primary mt-8">홈으로 돌아가기</a>
        </div>
      </div>
    </div>
  </section>
</Base>

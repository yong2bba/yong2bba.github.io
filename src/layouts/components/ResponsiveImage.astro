---
import { getResponsiveImage } from "@/lib/responsiveImages";

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes,
  priority = false,
  class: className,
} = Astro.props;
const image = getResponsiveImage(src);
const avifSrcset = image?.sources.avif
  .map((variant) => `${variant.src} ${variant.width}w`)
  .join(", ");
const webpSrcset = image?.sources.webp
  .map((variant) => `${variant.src} ${variant.width}w`)
  .join(", ");
const fallback = image?.sources.webp.at(-1);
---

{
  image && fallback ? (
    <picture data-responsive-image={src}>
      <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
      <source type="image/webp" srcset={webpSrcset} sizes={sizes} />
      <img
        src={fallback.src}
        alt={alt}
        width={fallback.width}
        height={fallback.height}
        sizes={sizes}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        class={className}
      />
    </picture>
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding="async"
      class={className}
    />
  )
}

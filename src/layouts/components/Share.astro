---
import config from "@/config/config.json";
import {
  IoLogoFacebook,
  IoLogoLinkedin,
  IoLogoPinterest,
  IoLogoTwitter,
} from "react-icons/io5";

const { base_url }: { base_url: string } = config.site;
const {
  title,
  description,
  slug,
  className,
}: {
  title?: string;
  description?: string;
  slug?: string;
  className?: string;
} = Astro.props;

const pageUrl = new URL(
  (slug || "").replace(/^\/+/, ""),
  `${base_url.replace(/\/$/, "")}/`,
).toString();
const facebookUrl = `https://facebook.com/sharer/sharer.php?${new URLSearchParams({ u: pageUrl })}`;
const twitterUrl = `https://twitter.com/intent/tweet/?${new URLSearchParams({ text: title || "", url: pageUrl })}`;
const linkedinUrl = `https://www.linkedin.com/shareArticle?${new URLSearchParams(
  {
    mini: "true",
    url: pageUrl,
    title: title || "",
    summary: description || "",
    source: base_url,
  },
)}`;
const pinterestUrl = `https://pinterest.com/pin/create/button/?${new URLSearchParams(
  {
    url: pageUrl,
    media: "",
    description: description || "",
  },
)}`;
---

<ul class={`${className}`}>
  <li class="inline-block">
    <a
      aria-label="페이스북에 공유"
      href={facebookUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoFacebook />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="X에 공유"
      href={twitterUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoTwitter />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="링크드인에 공유"
      href={linkedinUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoLinkedin />
    </a>
  </li>
  <li class="inline-block">
    <a
      aria-label="핀터레스트에 공유"
      href={pinterestUrl}
      target="_blank"
      rel="noreferrer noopener"
    >
      <IoLogoPinterest />
    </a>
  </li>
</ul>
